$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty

## name:     DEVGRU 🔱
## blurb:    Naval Special Warfare aesthetic — gunmetal black, amber trident.

# The basic colors
foreground              #ede3ce
background              #060604
selection_foreground    #150f03
selection_background    #e8b02e

# Cursor colors
cursor                  #e8b02e
cursor_text_color       #060604

# URL underline color when hovering with mouse
url_color               #edc157

# Kitty window border colors
active_border_color     #e8b02e
inactive_border_color   #2a2416
bell_border_color       #c84b4b

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Window layout
window_padding_width    25

# Tab bar colors
active_tab_foreground   #150f03
active_tab_background   #e8b02e
inactive_tab_foreground #93865f
inactive_tab_background #14120c
tab_bar_background      #060604

# Colors for marks (marked text in the terminal)
mark1_foreground #060604
mark1_background #e8b02e
mark2_foreground #060604
mark2_background #a69c84
mark3_foreground #060604
mark3_background #c84b4b

# The 16 terminal colors

# black
color0 #2a2416
color8 #5c4f2c

# red
color1 #c84b4b
color9 #e06c6c

# green
color2  #8a9a3f
color10 #a8b856

# yellow
color3  #e8b02e
color11 #edc157

# blue
color4  #b0913d
color12 #cdad55

# magenta
color5  #c99a4f
color13 #e0b877

# cyan
color6  #b8a15c
color14 #d6c188

# white
color7  #ded2b8
color15 #faf3e2
