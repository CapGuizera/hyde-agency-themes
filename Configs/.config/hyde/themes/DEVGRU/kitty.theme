$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty

## name:     DEVGRU 🔱
## blurb:    Naval Special Warfare aesthetic — gunmetal black, night-vision green.

# The basic colors
foreground              #d8e6dc
background              #050806
selection_foreground    #05130b
selection_background    #3fe07f

# Cursor colors
cursor                  #3fe07f
cursor_text_color       #050806

# URL underline color when hovering with mouse
url_color               #63e799

# Kitty window border colors
active_border_color     #3fe07f
inactive_border_color   #1c2a24
bell_border_color       #c84b4b

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Window layout
window_padding_width    25

# Tab bar colors
active_tab_foreground   #05130b
active_tab_background   #3fe07f
inactive_tab_foreground #5c9375
inactive_tab_background #0d1512
tab_bar_background      #050806

# Colors for marks (marked text in the terminal)
mark1_foreground #050806
mark1_background #3fe07f
mark2_foreground #050806
mark2_background #c9a227
mark3_foreground #050806
mark3_background #c84b4b

# The 16 terminal colors

# black
color0 #1c2a24
color8 #3a5d4b

# red
color1 #c84b4b
color9 #e06c6c

# green
color2  #3fe07f
color10 #63e799

# yellow
color3  #c9a227
color11 #ddb94f

# blue
color4  #4fa774
color12 #69d497

# magenta
color5  #7fd8a8
color13 #a8ecc4

# cyan
color6  #48c9a0
color14 #7fe3c4

# white
color7  #c4e8d2
color15 #eafbf0
