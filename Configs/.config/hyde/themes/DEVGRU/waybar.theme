$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
@define-color bar-bg rgba(6, 6, 4, 0);

@define-color main-bg rgba(16, 14, 9, 0.84);
@define-color main-fg #ede3ce;

@define-color wb-act-bg #e8b02e;
@define-color wb-act-fg #150f03;

@define-color wb-hvr-bg #edc157;
@define-color wb-hvr-fg #150f03;
