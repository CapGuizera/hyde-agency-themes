$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
@define-color bar-bg rgba(5, 8, 6, 0);

@define-color main-bg rgba(9, 16, 12, 0.84);
@define-color main-fg #d8e6dc;

@define-color wb-act-bg #3fe07f;
@define-color wb-act-fg #05130b;

@define-color wb-hvr-bg #63e799;
@define-color wb-hvr-fg #05130b;
